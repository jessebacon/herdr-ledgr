# Herdr regenerates these in every mod folder
**/gpui-kit.d.ts
**/jsconfig.json

# Generated by install.sh: engine copies inside a host mod (an overlay's mods/<name>/ledgr/)
examples/*/mods/*/ledgr/

# A personal answers file for ./install.sh --yes --answers (keep yours out of the repo)
ledgr.install.json

# Python
__pycache__/
*.pyc

# Runtime data lives in <Herdr home>/ledgr-data, never here
ledgr-data/

# The maintainer's exported design conversation, kept local (never in the repo)
docs/history/

.DS_Store
