{
  "$comment": "The repo owner's answers with only the primary settings file (his real ones, with a second config folder, live in the gitignored answers.local.json): ./install.sh --yes --answers examples/personal-overlay/answers.json",
  "overlay": "examples/personal-overlay",
  "agents": [
    "claude"
  ],
  "claude_settings": [
    "~/.claude/settings.json"
  ],
  "provider": "anthropic",
  "model": "claude-haiku-5-5",
  "api_key": "keep",
  "instruct_block": true,
  "asks_handoff": "ledgr",
  "threshold": "blocking",
  "animations": true,
  "fold_asks_while_working": false,
  "keys": {
    "capture": "cmd-j",
    "toggle": "cmd-shift-j"
  },
  "layout": {
    "name": "custom",
    "panel": "stack",
    "panel_stack": "panel-body",
    "host": "my-tabs",
    "chip": "ledgr-pane"
  },
  "run_tests": true,
  "mcp": true
}
