{
  "$comment": "The repo owner's answers: ./install.sh --yes --answers examples/personal-overlay/answers.json",
  "overlay": "examples/personal-overlay",
  "agents": ["claude"],
  "provider": "anthropic",
  "model": "claude-haiku-5-5",
  "api_key": "keep",
  "instruct_block": false,
  "threshold": "blocking",
  "animations": true,
  "fold_asks_while_working": false,
  "keys": { "capture": "cmd-j", "toggle": "cmd-shift-j" },
  "layout": { "name": "custom", "panel": "stack", "panel_stack": "panel-body", "host": "my-tabs", "chip": "my-pane" },
  "run_tests": true
}
